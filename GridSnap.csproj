<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GridSnap</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Default game folder per OS. Override with: dotnet build -p:GameDir="/path/to/MDS" -->
  <PropertyGroup Condition="'$(GameDir)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\My dream setup\MDS</GameDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameDir)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">
    <GameDir>$(HOME)/.local/share/Steam/steamapps/common/My dream setup/MDS</GameDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameDir)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">
    <GameDir>$(HOME)/Library/Application Support/Steam/steamapps/common/My dream setup/MDS</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BepInEx"><HintPath>$(GameDir)/BepInEx/core/BepInEx.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDir)/MDS_Data/Managed/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameDir)/MDS_Data/Managed/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)/MDS_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameDir)/MDS_Data/Managed/UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameDir)/MDS_Data/Managed/UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameDir)/MDS_Data/Managed/UnityEngine.TextRenderingModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
